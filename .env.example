DB_URL=postgres://user:password@localhost:5432/dbname?minsize=8&maxsize=30

HEITER_BASE_URL=http://localhost:8080/v1
HEITER_MODEL_NAME=your-model-name
HEITER_TOKEN=your-heiter-token

ENGINE_VERSION=0.1.0
ENGINE_NAME=fern

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
JWT_ALGO=RS256

ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=604800

S3_ENDPOINT_URL=https://your-s3-endpoint
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
BUCKET_NAME=your-bucket-name
S3_REGION_NAME=your-region

MAX_COVER_SIZE=5242880
ALLOWED_COVER_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]
ALLOWED_COVER_MIME_TYPES=["image/jpeg","image/png","image/webp"]

MAX_MODEL_SIZE=104857600
ALLOWED_MODEL_EXTENSIONS=[".vrm"]
ALLOWED_MODEL_MIME_TYPES=["model/gltf-binary","application/octet-stream"]

REDIS_HOST=redis
REDIS_PASSWORD=some-redis-password

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db

CARTESIA_API_KEY=ur-cartesia-api-key
CARTESIA_VOICE_ID=ur-cartesia-voice-id